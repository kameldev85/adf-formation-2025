{
	"name": "PL_ControlFlowSwitch",
	"properties": {
		"activities": [
			{
				"name": "Get Output Files",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "DS_ADLS_Output_Json",
						"type": "DatasetReference",
						"parameters": {
							"FileName": "  "
						}
					},
					"fieldList": [
						"itemType",
						"itemName",
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "JsonReadSettings"
					}
				}
			},
			{
				"name": "Switch1",
				"type": "Switch",
				"dependsOn": [
					{
						"activity": "Get Output Files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"on": {
						"value": "@activity('Get Output Files').output.itemType",
						"type": "Expression"
					},
					"cases": [
						{
							"value": "Folder",
							"activities": [
								{
									"name": "Set SubItems",
									"type": "SetVariable",
									"dependsOn": [],
									"policy": {
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"variableName": "SubFoldersAndFiles",
										"value": {
											"value": "@activity('Get Output Files').output.childItems",
											"type": "Expression"
										}
									}
								}
							]
						},
						{
							"value": "File",
							"activities": [
								{
									"name": "Set File Type",
									"type": "SetVariable",
									"dependsOn": [],
									"policy": {
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"variableName": "FileType",
										"value": {
											"value": "@concat(\n    'File Type : ',\n    last(split(activity('Get Output Files').output.itemName,'.'))\n)",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			},
			{
				"name": "FE_ExtractFiles",
				"type": "ForEach",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [
					{
						"activity": "Filter_JSON",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Filter_CSV').output.Value",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "CP_File_to_CSV",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "JsonSource",
									"storeSettings": {
										"type": "AzureBlobFSReadSettings",
										"recursive": true,
										"enablePartitionDiscovery": false
									},
									"formatSettings": {
										"type": "JsonReadSettings"
									}
								},
								"sink": {
									"type": "DelimitedTextSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings",
										"copyBehavior": "PreserveHierarchy"
									},
									"formatSettings": {
										"type": "DelimitedTextWriteSettings",
										"quoteAllText": true,
										"fileExtension": ".txt"
									}
								},
								"enableStaging": false
							},
							"inputs": [
								{
									"referenceName": "DS_ADLS_Output_Json",
									"type": "DatasetReference",
									"parameters": {
										"FileName": {
											"value": "@item().name",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "DS_ADLS_Input_CSV",
									"type": "DatasetReference"
								}
							]
						}
					]
				}
			},
			{
				"name": "Filter_JSON",
				"type": "Filter",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [
					{
						"activity": "Get Output Files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Get Output Files').output.childItems",
						"type": "Expression"
					},
					"condition": {
						"value": "@endswith(item().name, '.json')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Until1",
				"type": "Until",
				"dependsOn": [
					{
						"activity": "Set Liste des fichiers",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@empty(variables('ListeDesFichiers'))",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "CP_File_to_CSV_until",
							"type": "Copy",
							"dependsOn": [
								{
									"activity": "Set Current Item Name",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "JsonSource",
									"storeSettings": {
										"type": "AzureBlobFSReadSettings",
										"recursive": true,
										"enablePartitionDiscovery": false
									},
									"formatSettings": {
										"type": "JsonReadSettings"
									}
								},
								"sink": {
									"type": "DelimitedTextSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings",
										"copyBehavior": "PreserveHierarchy"
									},
									"formatSettings": {
										"type": "DelimitedTextWriteSettings",
										"quoteAllText": true,
										"fileExtension": ".txt"
									}
								},
								"enableStaging": false
							},
							"inputs": [
								{
									"referenceName": "DS_ADLS_Output_Json",
									"type": "DatasetReference",
									"parameters": {
										"FileName": {
											"value": "@variables('currentItemName')",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "DS_ADLS_Input_CSV",
									"type": "DatasetReference"
								}
							]
						},
						{
							"name": "Set Current Item Name",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "currentItemName",
								"value": {
									"value": "@first(variables('ListeDesFichiers')).name",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Set new List",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "CP_File_to_CSV_until",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "TempListFichier",
								"value": {
									"value": "@skip(variables('ListeDesFichiers'), 1)",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Update ListdesFichiers",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Set new List",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "ListeDesFichiers",
								"value": {
									"value": "@variables('TempListFichier')",
									"type": "Expression"
								}
							}
						}
					],
					"timeout": "0.12:00:00"
				}
			},
			{
				"name": "Set Liste des fichiers",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Get Output Files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "ListeDesFichiers",
					"value": {
						"value": "@activity('Get Output Files').output.childItems",
						"type": "Expression"
					}
				}
			}
		],
		"variables": {
			"SubFoldersAndFiles": {
				"type": "Array"
			},
			"FileType": {
				"type": "String"
			},
			"ListeDesFichiers": {
				"type": "Array"
			},
			"currentItemName": {
				"type": "String"
			},
			"TempListFichier": {
				"type": "Array"
			}
		},
		"annotations": []
	}
}