{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Nom de fabrique de données",
			"defaultValue": "ADF-Formation-Integration-KT"
		},
		"LS_ADLS_FORMATION_KT_accountKey": {
			"type": "secureString",
			"metadata": "Chaîne sécurisée pour « accountKey » de « LS_ADLS_FORMATION_KT »"
		},
		"LS_ASQL_Formation_password": {
			"type": "secureString",
			"metadata": "Chaîne sécurisée pour « password » de « LS_ASQL_Formation »"
		},
		"LS_ADLS_FORMATION_KT_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://saformationadfkt.dfs.core.windows.net/"
		},
		"LS_ASQL_Formation_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "mss-formation-kt.database.windows.net"
		},
		"LS_ASQL_Formation_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "free-sql-db-kt"
		},
		"LS_ASQL_Formation_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "admin-kt"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI pour le compte de stockage contenant des modèles ARM liés"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Jeton SAS pour le compte de stockage contenant des modèles ARM liés"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "ADF-Formation-Integration-KT_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_ADLS_FORMATION_KT_accountKey": {
						"value": "[parameters('LS_ADLS_FORMATION_KT_accountKey')]"
					},
					"LS_ASQL_Formation_password": {
						"value": "[parameters('LS_ASQL_Formation_password')]"
					},
					"LS_ADLS_FORMATION_KT_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_FORMATION_KT_properties_typeProperties_url')]"
					},
					"LS_ASQL_Formation_properties_typeProperties_server": {
						"value": "[parameters('LS_ASQL_Formation_properties_typeProperties_server')]"
					},
					"LS_ASQL_Formation_properties_typeProperties_database": {
						"value": "[parameters('LS_ASQL_Formation_properties_typeProperties_database')]"
					},
					"LS_ASQL_Formation_properties_typeProperties_userName": {
						"value": "[parameters('LS_ASQL_Formation_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}